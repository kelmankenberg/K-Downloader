{
  "name": "k-downloader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "desktopName": "k-downloader.desktop",
  "description": "Linux desktop downloader for public KHInsider album tracks",
  "author": "kelmankenberg",
  "homepage": "https://github.com/kelmankenberg/K-Downloader",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "build:gui": "node scripts/build-gui.mjs",
    "package:linux": "node scripts/package-linux.mjs",
    "package:deb": "node scripts/package-linux.mjs deb",
    "package:arch": "node scripts/package-linux.mjs pacman",
    "package:aur": "node scripts/generate-aur.mjs",
    "package:appimage": "node scripts/package-linux.mjs AppImage",
    "package:dir": "node scripts/package-linux.mjs dir",
    "test:packages": "node scripts/test-packages.mjs",
    "gui": "npm run build:gui && electron dist/electron/main.cjs",
    "inspect": "tsx src/cli.ts inspect",
    "download": "tsx src/cli.ts download",
    "pretest": "npm run build:gui",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "lucide": "^1.55.0",
    "marked": "^18.1.1",
    "parse5": "^7.3.0",
    "playwright": "^1.55.0"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
